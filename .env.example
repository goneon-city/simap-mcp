# Environment variables for simap-mcp.
# Copy to .env and adjust as needed; both `1` and `true` enable boolean flags.

# Enable verbose stderr logging of every HTTP request/response to the SIMAP API.
# Useful for local debugging. Leave unset in production: logs include user
# search terms and filter values.
# Default: disabled.
SIMAP_MCP_DEBUG=

# --- Remote (Streamable HTTP) deployment only, e.g. Railway ---
# These only matter when PORT is set; local stdio usage ignores them.

# Set automatically by most PaaS hosts (e.g. Railway). Leave unset for local
# stdio usage. When set, the server listens over Streamable HTTP instead.
PORT=

# Required whenever PORT is set: a secret bearer token that callers must send
# as `Authorization: Bearer <token>` to reach /mcp. Startup fails without it
# unless MCP_HTTP_ALLOW_ANONYMOUS is set. Generate one with e.g.
# `openssl rand -hex 24`.
MCP_HTTP_AUTH_TOKEN=

# Explicit opt-in to run the HTTP endpoint with no auth at all. Leave unset;
# only set this if you understand the endpoint will be open to anyone who can
# reach it.
MCP_HTTP_ALLOW_ANONYMOUS=
